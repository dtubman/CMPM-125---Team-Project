{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c70a6b8b1c7142e0978c5597f07d3484",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Noise3D (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -324.0000305175781,
            "y": -463.9999694824219,
            "width": 207.9999542236328,
            "height": 301.99993896484375
        }
    },
    "m_Slots": [
        {
            "m_Id": "aa897975190b4e33aead64d6472e9daf"
        },
        {
            "m_Id": "374d341bb2054536b8b0486d89ecfaff"
        },
        {
            "m_Id": "d1c4adce30294115afdc51cbec68e9d2"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Noise3D",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 p = Pos * Scale;\nfloat3 i = floor(p);\nfloat3 f = frac(p);\nf = f * f * (3.0 - 2.0 * f);\n\nfloat n = i.x + i.y * 57.0 + 113.0 * i.z;\nfloat a = frac(sin(n + 0.0) * 43758.5453);\nfloat b = frac(sin(n + 1.0) * 43758.5453);\nfloat c = frac(sin(n + 57.0) * 43758.5453);\nfloat d = frac(sin(n + 58.0) * 43758.5453);\nfloat e = frac(sin(n + 113.0) * 43758.5453);\nfloat f1 = frac(sin(n + 114.0) * 43758.5453);\nfloat g = frac(sin(n + 170.0) * 43758.5453);\nfloat h = frac(sin(n + 171.0) * 43758.5453);\n\nfloat k0 = lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);\nfloat k1 = lerp(lerp(e, f1, f.x), lerp(g, h, f.x), f.y);\nOut = lerp(k0, k1, f.z);\n"
}

